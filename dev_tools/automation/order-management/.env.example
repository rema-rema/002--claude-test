# Order Management Server Environment Configuration
# Copy this file to .env and fill in your actual values

# Discord Bot Configuration
CC_DISCORD_TOKEN=your_discord_bot_token_here
CC_DISCORD_CHANNEL_ID=1405815779198369903
CC_DISCORD_USER_ID=your_discord_user_id_here

# System Configuration
MAX_CONCURRENT_SESSIONS=10
SESSION_TIMEOUT=3600
QUEUE_CHECK_INTERVAL=5

# Performance Limits
MEMORY_LIMIT_PER_SESSION=2048
CPU_LIMIT_PER_SESSION=1
DISK_QUOTA_PER_SESSION=10240

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/order-management.log
DISCORD_LOG_CHANNEL=monitoring_channel_id

# Bridge Integration
BRIDGE_BASE_DIR=../claude-discord-bridge-server
BRIDGE_SESSIONS_FILE=../claude-discord-bridge-server/sessions.json