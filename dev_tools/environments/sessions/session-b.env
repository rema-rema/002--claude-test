# Session B Development Environment Configuration

SESSION_ID=B
SESSION_NAME=session-b

# Database Configuration
DATABASE_URL=postgresql://session_b_user:session_b_pass123@localhost:5402/session_b_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5402
POSTGRES_DB=session_b_dev
POSTGRES_USER=session_b_user
POSTGRES_PASSWORD=session_b_pass123

# Redis Configuration
REDIS_URL=redis://localhost:6402
REDIS_HOST=localhost
REDIS_PORT=6402
REDIS_DB=0

# Application Ports
FRONTEND_PORT=3002
BACKEND_PORT=8002

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_SESSION_ID=B

# Session-specific JWT Secret
JWT_SECRET=session_b_jwt_secret_key_very_secure_random_string

# Google OAuth Redirect
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/callback

# Security - Session B CORS
CORS_ORIGINS=http://localhost:3002,http://localhost:8002

# File Upload Directory
UPLOAD_DIR=./dev_tools/uploads/session-b

# Logging
LOG_FILE=./dev_tools/logs/session-b.log