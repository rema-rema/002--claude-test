# Session D Development Environment Configuration

SESSION_ID=D
SESSION_NAME=session-d

# Database Configuration
DATABASE_URL=postgresql://session_d_user:session_d_pass123@localhost:5404/session_d_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5404
POSTGRES_DB=session_d_dev
POSTGRES_USER=session_d_user
POSTGRES_PASSWORD=session_d_pass123

# Redis Configuration
REDIS_URL=redis://localhost:6404
REDIS_HOST=localhost
REDIS_PORT=6404
REDIS_DB=0

# Application Ports
FRONTEND_PORT=3004
BACKEND_PORT=8004

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8004
NEXT_PUBLIC_SESSION_ID=D

# Session-specific JWT Secret
JWT_SECRET=session_d_jwt_secret_key_very_secure_random_string

# Google OAuth Redirect
GOOGLE_REDIRECT_URI=http://localhost:3004/auth/callback

# Security - Session D CORS
CORS_ORIGINS=http://localhost:3004,http://localhost:8004

# File Upload Directory
UPLOAD_DIR=./dev_tools/uploads/session-d

# Logging
LOG_FILE=./dev_tools/logs/session-d.log