# Session C Development Environment Configuration

SESSION_ID=C
SESSION_NAME=session-c

# Database Configuration
DATABASE_URL=postgresql://session_c_user:session_c_pass123@localhost:5403/session_c_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5403
POSTGRES_DB=session_c_dev
POSTGRES_USER=session_c_user
POSTGRES_PASSWORD=session_c_pass123

# Redis Configuration
REDIS_URL=redis://localhost:6403
REDIS_HOST=localhost
REDIS_PORT=6403
REDIS_DB=0

# Application Ports
FRONTEND_PORT=3003
BACKEND_PORT=8003

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8003
NEXT_PUBLIC_SESSION_ID=C

# Session-specific JWT Secret
JWT_SECRET=session_c_jwt_secret_key_very_secure_random_string

# Google OAuth Redirect
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/callback

# Security - Session C CORS
CORS_ORIGINS=http://localhost:3003,http://localhost:8003

# File Upload Directory
UPLOAD_DIR=./dev_tools/uploads/session-c

# Logging
LOG_FILE=./dev_tools/logs/session-c.log