# Session A Development Environment Configuration

SESSION_ID=A
SESSION_NAME=session-a

# Database Configuration
DATABASE_URL=postgresql://session_a_user:session_a_pass123@localhost:5401/session_a_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5401
POSTGRES_DB=session_a_dev
POSTGRES_USER=session_a_user
POSTGRES_PASSWORD=session_a_pass123

# Redis Configuration
REDIS_URL=redis://localhost:6401
REDIS_HOST=localhost
REDIS_PORT=6401
REDIS_DB=0

# Application Ports
FRONTEND_PORT=3001
BACKEND_PORT=8001

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SESSION_ID=A

# Session-specific JWT Secret
JWT_SECRET=session_a_jwt_secret_key_very_secure_random_string

# Google OAuth Redirect
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# Security - Session A CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:8001

# File Upload Directory
UPLOAD_DIR=./dev_tools/uploads/session-a

# Logging
LOG_FILE=./dev_tools/logs/session-a.log