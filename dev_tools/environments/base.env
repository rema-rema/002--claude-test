# Base Configuration for Multi-Session Development Environment
# This file contains common settings shared across all sessions

# Common Application Settings
NODE_ENV=development
DEBUG=true
AUTO_RELOAD=true

# JWT Configuration (shared keys for development)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (shared across all sessions)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Security & CORS (template - will be overridden per session)
CORS_ORIGINS_TEMPLATE=http://localhost:FRONTEND_PORT,http://localhost:BACKEND_PORT

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760

# Logging Configuration
LOG_LEVEL=debug

# Development Features
AUTO_RELOAD=true