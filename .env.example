# Discord Bot Settings
CC_DISCORD_TOKEN=your-discord-bot-token
CC_DISCORD_CHANNEL_ID_002=your-main-channel-id
CC_DISCORD_CHANNEL_ID_002_RESULT=your-result-channel-id
CC_DISCORD_USER_ID=your-user-id
CC_CLAUDE_USER_ID=your-claude-user-id

# Multi-Session Channel Settings
CC_DISCORD_CHANNEL_ID_002_B=your-channel-b-id
CC_DISCORD_CHANNEL_ID_002_C=your-channel-c-id

# Claude API Settings
ANTHROPIC_API_KEY=your-anthropic-api-key

# GitHub Codespace Integration (Optional)
GITHUB_TOKEN=your-github-token
GITHUB_USERNAME=your-github-username
GITHUB_REPO_NAME=your-repo-name

# Discord Approval System Settings (Optional)
DISCORD_WEBHOOK_URL=your-discord-webhook-url
APPROVAL_TIMEOUT_HOURS=24
MAX_RETRY_COUNT=10

# Claude Code CLI Options
CLAUDE_OPTIONS=--dangerously-skip-permissions

# ===================
# Login Feature Settings
# ===================
# Copy these settings to your session-specific .env files and update values

# Session Configuration
NODE_ENV=development
SESSION_ID=1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://session1_user:session1_pass123@localhost:5401/session1_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5401
POSTGRES_DB=session1_dev
POSTGRES_USER=session1_user
POSTGRES_PASSWORD=session1_pass123

# Redis Configuration
REDIS_URL=redis://localhost:6401
REDIS_HOST=localhost
REDIS_PORT=6401
REDIS_DB=0

# Application Ports
FRONTEND_PORT=3001
BACKEND_PORT=8001

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SESSION_ID=1

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# Security Configuration
CORS_ORIGINS=http://localhost:3001,http://localhost:8001
SECRET_KEY=your_secret_key_for_general_encryption

# File Upload Configuration
UPLOAD_DIR=./uploads/session1
MAX_UPLOAD_SIZE=10485760

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=./logs/session1.log

# Development Features
DEBUG=true
AUTO_RELOAD=true