#!/usr/bin/env bash
#
# dp - Discord Postコマンド（マルチセッション対応）
#
# Usage:
#   dp "message"                    # デフォルトセッション(1)に送信
#   dp 2 "message"                  # セッション2に送信
#   dp --notify 2 "message"         # セッション2に通知形式で送信（相手Claudeが反応する）
#   dp -n 2 "message"               # 同上（短縮形）
#
# 送信元セッションは環境変数 CC_SESSION_ID から自動取得（未設定時は1）
#

TOOLKIT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# 送信元セッション（環境変数から取得、デフォルト1）
FROM_SESSION="${CC_SESSION_ID:-1}"

# オプション解析
NOTIFY_MODE=""
SESSION=""
MESSAGE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --notify|-n)
            NOTIFY_MODE="--notify"
            shift
            ;;
        *)
            if [ -z "$SESSION" ] && [[ "$1" =~ ^[0-9]+$ ]] && [ ${#1} -lt 5 ]; then
                SESSION="$1"
            elif [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            fi
            shift
            ;;
    esac
done

# 引数チェック
if [ -z "$MESSAGE" ]; then
    if [ -z "$SESSION" ]; then
        echo "Usage: dp [--notify|-n] [session] \"message\""
        echo ""
        echo "Options:"
        echo "  --notify, -n  Send as notification (triggers Claude response)"
        echo ""
        echo "Examples:"
        echo "  dp \"hello\"              # Send to default session"
        echo "  dp 2 \"hello\"            # Send to session 2"
        echo "  dp --notify 2 \"task\"    # Notify session 2 (Claude responds)"
        exit 1
    fi
    # SESSIONしかない場合、それをMESSAGEとして扱う
    MESSAGE="$SESSION"
    SESSION="1"
fi

# セッション番号のデフォルト
if [ -z "$SESSION" ]; then
    SESSION="1"
fi

# 送信
if [ -n "$NOTIFY_MODE" ]; then
    echo -e "$MESSAGE" | python3 "$TOOLKIT_ROOT/src/discord_post.py" "$SESSION" --notify --from "$FROM_SESSION"
else
    echo -e "$MESSAGE" | python3 "$TOOLKIT_ROOT/src/discord_post.py" "$SESSION"
fi
